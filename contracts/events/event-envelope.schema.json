{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerceflow.demo/schemas/events/event-envelope.schema.json",
  "title": "CommerceFlow Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "timestamp",
    "correlationId",
    "producer",
    "aggregateId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$"
    },
    "eventVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
