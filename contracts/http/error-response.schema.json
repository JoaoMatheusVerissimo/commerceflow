{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commerceflow.demo/schemas/http/error-response.schema.json",
  "title": "CommerceFlow API Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "status", "code", "message", "path", "correlationId"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "fieldErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "code", "message"],
        "properties": {
          "field": { "type": "string" },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
